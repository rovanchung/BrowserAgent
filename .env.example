# ── LLM Provider ─────────────────────────────────────────────────────
# Options: openai, anthropic, google, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# ── API Keys (uncomment the one you use) ─────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ── Ollama (local model) ─────────────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:70b
# OLLAMA_BASE_URL=http://localhost:11434

# ── Browser ──────────────────────────────────────────────────────────
# Path to Chrome user-data dir to reuse your login session.
# Find yours: chrome://version → "Profile Path" (use the parent dir)
# CHROME_PROFILE_PATH=/home/you/.config/google-chrome/Default
